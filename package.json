{
  "name": "table-export-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Manifest V3 extension: find tables on a page, export one to CSV or XLSX, or copy as TSV.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "npm run build:test && playwright test",
    "zip": "node scripts/zip.mjs",
    "screenshot": "npm run build:test && node scripts/screenshot.mjs"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
